rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userProfile(userId) {
      return get(/databases/$(database)/documents/userProfiles/$(userId));
    }

    function isAdmin() {
      return isSignedIn() && userProfile(request.auth.uid).data.isAdmin == true;
    }

    function projectMemberDoc(projectId) {
      return get(/databases/$(database)/documents/projectMembers/$(projectId + '_' + request.auth.uid));
    }

    function projectMemberDocByUser(projectId, userId) {
      return get(/databases/$(database)/documents/projectMembers/$(projectId + '_' + userId));
    }

    function isProjectMember(projectId) {
      return isSignedIn() && projectMemberDoc(projectId).data.role in ['leader', 'member'];
    }

    function isProjectMemberById(projectId, userId) {
      return isSignedIn()
        && projectMemberDocByUser(projectId, userId).data.role in ['leader', 'member'];
    }

    function isProjectLeader(projectId) {
      return isSignedIn() && projectMemberDoc(projectId).data.role == 'leader';
    }

    function isDocumentAuthor() {
      let authorId = (
        resource.data.authorId is string
        && resource.data.authorId.size() > 0
      ) ? resource.data.authorId : resource.data.createdBy;
      return isSignedIn() && authorId == request.auth.uid;
    }

    function isShortIdAssignment() {
      return isAdmin()
        && resource.data.shortId == null
        && request.resource.data.shortId is int
        && request.resource.data.shortId > 0
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'shortId',
          'updatedAt',
          'updatedBy'
        ]);
    }

    function versionDoc(versionId) {
      return get(/databases/$(database)/documents/versions/$(versionId));
    }

    function versionAfter(versionId) {
      return getAfter(/databases/$(database)/documents/versions/$(versionId));
    }

    function threadDoc(threadId) {
      return get(/databases/$(database)/documents/threads/$(threadId));
    }

    function threadAfter(threadId) {
      return getAfter(/databases/$(database)/documents/threads/$(threadId));
    }

    function documentDoc(docId) {
      return get(/databases/$(database)/documents/documents/$(docId));
    }

    function documentAfter(docId) {
      return getAfter(/databases/$(database)/documents/documents/$(docId));
    }

    function isVersionAuthorById(versionId) {
      return isSignedIn() && versionDoc(versionId).data.createdBy == request.auth.uid;
    }

    function isVersionReviewerById(versionId) {
      return isSignedIn() && request.auth.uid in versionDoc(versionId).data.reviewerIds;
    }

    function isVersionAuthor(resourceData) {
      return isSignedIn() && resourceData.createdBy == request.auth.uid;
    }

    function isVersionReviewer(resourceData) {
      return isSignedIn()
        && resourceData.reviewerIds is list
        && request.auth.uid in resourceData.reviewerIds;
    }

    function versionNumThreads(versionData) {
      return (
        versionData.stats is map
        && versionData.stats.numThreads is int
      ) ? versionData.stats.numThreads : (
        versionData.numThreads is int
      ) ? versionData.numThreads : 0;
    }

    function versionNumOpenThreads(versionData) {
      return (
        versionData.stats is map
        && versionData.stats.numOpenThreads is int
      ) ? versionData.stats.numOpenThreads : (
        versionData.numOpenThreads is int
      ) ? versionData.numOpenThreads : 0;
    }

    function versionNumComments(versionData) {
      return (
        versionData.stats is map
        && versionData.stats.numComments is int
      ) ? versionData.stats.numComments : (
        versionData.numComments is int
      ) ? versionData.numComments : 0;
    }

    function versionNumThreadsWithTwoPlusComments(versionData) {
      return (
        versionData.stats is map
        && versionData.stats.numThreadsWithTwoPlusComments is int
      ) ? versionData.stats.numThreadsWithTwoPlusComments : (
        versionData.numThreadsWithTwoPlusComments is int
      ) ? versionData.numThreadsWithTwoPlusComments : 0;
    }

    function hasReviewEvidence(versionData) {
      return versionData.hasFile == true
        && versionNumThreads(versionData) > 0
        && versionNumComments(versionData) >= 0
        && versionNumThreadsWithTwoPlusComments(versionData) > 0
        && versionNumOpenThreads(versionData) == 0;
    }

    function isStartReviewTransition() {
      return resource.data.status == 'In Creation'
        && request.resource.data.status == 'In Review'
        && resource.data.hasFile == true
        && request.resource.data.number == resource.data.number;
    }

    function isAcceptTransition() {
      return resource.data.status == 'In Review'
        && request.resource.data.status == 'Accepted'
        && hasReviewEvidence(resource.data)
        && request.resource.data.number
          == resource.data.number + (100 - (resource.data.number % 100));
    }

    function isRejectTransition() {
      return resource.data.status == 'In Review'
        && request.resource.data.status == 'Rejected'
        && hasReviewEvidence(resource.data)
        && request.resource.data.number == resource.data.number;
    }

    function isReviewedTransition() {
      return resource.data.status == 'In Review'
        && request.resource.data.status == 'Reviewed'
        && request.resource.data.number == resource.data.number;
    }
    function isReplacedTransition() {
      return resource.data.status == 'Accepted'
        && request.resource.data.status == 'Replaced'
        && request.resource.data.number == resource.data.number;
    }

    function isReviewStatsOnlyUpdate(versionId) {
      return request.resource.data.status == resource.data.status
        && resource.data.status == 'In Review'
        && request.resource.data.number == resource.data.number
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.docId == resource.data.docId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.reviewerIds == resource.data.reviewerIds
        && request.resource.data.hasFile == resource.data.hasFile
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'stats',
          'numThreads',
          'numOpenThreads',
          'numComments',
          'numThreadsWithTwoPlusComments',
          'activityAt',
          'updatedAt',
          'updatedBy'
        ])
        && canReviewAccess(resource.data.projectId, versionId);
    }

    function isAdminStatsBackfill() {
      return isAdmin()
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.docId == resource.data.docId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.number == resource.data.number
        && request.resource.data.status == resource.data.status
        && request.resource.data.reviewerIds == resource.data.reviewerIds
        && request.resource.data.hasFile == resource.data.hasFile
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'stats',
          'numThreads',
          'numOpenThreads',
          'numComments',
          'numThreadsWithTwoPlusComments',
          'updatedAt',
          'updatedBy'
        ]);
    }

    function isThreadCreateWithVersionStatIncrement(versionId) {
      return versionNumThreads(versionAfter(versionId).data) == versionNumThreads(versionDoc(versionId).data) + 1
        && versionNumOpenThreads(versionAfter(versionId).data) == versionNumOpenThreads(versionDoc(versionId).data) + 1
        && versionNumComments(versionAfter(versionId).data) == versionNumComments(versionDoc(versionId).data)
        && versionNumThreadsWithTwoPlusComments(versionAfter(versionId).data)
          == versionNumThreadsWithTwoPlusComments(versionDoc(versionId).data)
        && versionAfter(versionId).data.numThreads == versionNumThreads(versionDoc(versionId).data) + 1
        && versionAfter(versionId).data.numOpenThreads == versionNumOpenThreads(versionDoc(versionId).data) + 1
        && versionAfter(versionId).data.numComments == versionNumComments(versionDoc(versionId).data)
        && versionAfter(versionId).data.numThreadsWithTwoPlusComments
          == versionNumThreadsWithTwoPlusComments(versionDoc(versionId).data);
    }

    function isCommentCreateWithVersionStatIncrement(versionId, threadId) {
      let incrementTwoPlus = (
        threadDoc(threadId).data.commentCount < 2
        && threadAfter(threadId).data.commentCount >= 2
      ) ? 1 : 0;
      return versionNumThreads(versionAfter(versionId).data) == versionNumThreads(versionDoc(versionId).data)
        && versionNumOpenThreads(versionAfter(versionId).data) == versionNumOpenThreads(versionDoc(versionId).data)
        && versionNumComments(versionAfter(versionId).data) == versionNumComments(versionDoc(versionId).data) + 1
        && versionNumThreadsWithTwoPlusComments(versionAfter(versionId).data)
          == versionNumThreadsWithTwoPlusComments(versionDoc(versionId).data) + incrementTwoPlus
        && versionAfter(versionId).data.numThreads == versionNumThreads(versionDoc(versionId).data)
        && versionAfter(versionId).data.numOpenThreads == versionNumOpenThreads(versionDoc(versionId).data)
        && versionAfter(versionId).data.numComments == versionNumComments(versionDoc(versionId).data) + 1
        && versionAfter(versionId).data.numThreadsWithTwoPlusComments
          == versionNumThreadsWithTwoPlusComments(versionDoc(versionId).data) + incrementTwoPlus;
    }

    function isAdminProjectIdBackfill() {
      return isAdmin()
        && (resource.data.projectId == null || resource.data.projectId == '')
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() > 0
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'projectId',
          'updatedAt',
          'updatedBy'
        ]);
    }

    function isThreadStatusWithVersionOpenCounter(versionId, isClosing) {
      return versionNumThreads(versionAfter(versionId).data) == versionNumThreads(versionDoc(versionId).data)
        && versionNumComments(versionAfter(versionId).data) == versionNumComments(versionDoc(versionId).data)
        && versionNumThreadsWithTwoPlusComments(versionAfter(versionId).data)
          == versionNumThreadsWithTwoPlusComments(versionDoc(versionId).data)
        && versionAfter(versionId).data.numThreads == versionNumThreads(versionDoc(versionId).data)
        && versionAfter(versionId).data.numComments == versionNumComments(versionDoc(versionId).data)
        && versionAfter(versionId).data.numThreadsWithTwoPlusComments
          == versionNumThreadsWithTwoPlusComments(versionDoc(versionId).data)
        && (
          (isClosing
            && versionNumOpenThreads(versionAfter(versionId).data) == versionNumOpenThreads(versionDoc(versionId).data) - 1
            && versionAfter(versionId).data.numOpenThreads == versionNumOpenThreads(versionDoc(versionId).data) - 1)
          ||
          (!isClosing
            && versionNumOpenThreads(versionAfter(versionId).data) == versionNumOpenThreads(versionDoc(versionId).data) + 1
            && versionAfter(versionId).data.numOpenThreads == versionNumOpenThreads(versionDoc(versionId).data) + 1)
        );
    }

    function isSameStatusUpdateAllowed() {
      return request.resource.data.status == resource.data.status
        && (
          resource.data.status == 'In Creation'
          || request.resource.data.reviewerIds == resource.data.reviewerIds
        )
        && (
          resource.data.status == 'In Creation'
          || request.resource.data.hasFile == resource.data.hasFile
        );
    }

    function isAuthorReassignmentAllowed() {
      return resource.data.status == 'In Creation'
        && (isProjectLeader(resource.data.projectId) || isAdmin())
        && request.resource.data.status == 'In Creation'
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() > 0
        && request.resource.data.createdBy != resource.data.createdBy
        && request.resource.data.reviewerIds is list
        && !(request.resource.data.createdBy in request.resource.data.reviewerIds)
        && isProjectMemberById(resource.data.projectId, request.resource.data.createdBy)
        && request.resource.data.docId == resource.data.docId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'createdBy',
          'reviewerIds',
          'updatedAt',
          'updatedBy'
        ]);
    }

    function isDocumentCreatorForDocId(docId) {
      return isSignedIn()
        && (
          documentDoc(docId).data.createdBy == request.auth.uid
          || documentAfter(docId).data.createdBy == request.auth.uid
        );
    }

    function isLatestVersionAuthorForCreate(projectId, docId, versionNumber, previousVersionId) {
      return isSignedIn()
        && previousVersionId is string
        && previousVersionId.size() > 0
        && versionNumber is int
        && versionNumber > 1
        && versionDoc(previousVersionId).data.projectId == projectId
        && versionDoc(previousVersionId).data.docId == docId
        && versionDoc(previousVersionId).data.number is int
        && versionDoc(previousVersionId).data.number == versionNumber - 1
        && versionDoc(previousVersionId).data.createdBy == request.auth.uid;
    }

    function canCreateVersionByPolicy(projectId, docId, versionNumber, previousVersionId) {
      return isAdmin()
        || isProjectLeader(projectId)
        || isLatestVersionAuthorForCreate(projectId, docId, versionNumber, previousVersionId)
        || (versionNumber == 1 && isDocumentCreatorForDocId(docId));
    }

    function hasPreviousVersionChainForCounter(projectId, docId, nextNumber, previousVersionId) {
      return previousVersionId is string
        && previousVersionId.size() > 0
        && nextNumber is int
        && nextNumber > 2
        && versionDoc(previousVersionId).data.projectId == projectId
        && versionDoc(previousVersionId).data.docId == docId
        && versionDoc(previousVersionId).data.number is int
        && versionDoc(previousVersionId).data.number == nextNumber - 2;
    }

    function isAcceptedVersionCounterJump(projectId, docId, nextNumber, previousVersionId) {
      return previousVersionId is string
        && previousVersionId.size() > 0
        && nextNumber is int
        && nextNumber > 1
        && (
          (
            versionDoc(previousVersionId).data.projectId == projectId
            && versionDoc(previousVersionId).data.docId == docId
            && versionDoc(previousVersionId).data.status == 'Accepted'
            && versionDoc(previousVersionId).data.number is int
            && versionDoc(previousVersionId).data.number % 100 == 0
            && versionDoc(previousVersionId).data.number == nextNumber - 1
          )
          || (
            versionAfter(previousVersionId).data.projectId == projectId
            && versionAfter(previousVersionId).data.docId == docId
            && versionAfter(previousVersionId).data.status == 'Accepted'
            && versionAfter(previousVersionId).data.number is int
            && versionAfter(previousVersionId).data.number % 100 == 0
            && versionAfter(previousVersionId).data.number == nextNumber - 1
          )
        );
    }

    function hasPreviousVersionChainForCreate(projectId, docId, versionNumber, previousVersionId) {
      return previousVersionId is string
        && previousVersionId.size() > 0
        && versionNumber is int
        && versionNumber > 1
        && versionDoc(previousVersionId).data.projectId == projectId
        && versionDoc(previousVersionId).data.docId == docId
        && versionDoc(previousVersionId).data.number is int
        && versionDoc(previousVersionId).data.number == versionNumber - 1;
    }

    function canReviewAccess(projectId, versionId) {
      return isAdmin()
        || isProjectLeader(projectId)
        || isVersionAuthorById(versionId)
        || isVersionReviewerById(versionId);
    }

    function canReviewAccessByVersionId(versionId) {
      return isAdmin()
        || isProjectLeader(versionDoc(versionId).data.projectId)
        || isVersionAuthorById(versionId)
        || isVersionReviewerById(versionId);
    }

    function canReviewContribute(projectId, versionId) {
      return isAdmin()
        || isProjectLeader(projectId)
        || isVersionAuthorById(versionId)
        || isVersionReviewerById(versionId);
    }

    function resolvedFileProjectId(fileData) {
      return (
        fileData.projectId is string
        && fileData.projectId.size() > 0
      ) ? fileData.projectId : (
        fileData.versionId is string
        && fileData.versionId.size() > 0
        && versionDoc(fileData.versionId).data.projectId is string
        && versionDoc(fileData.versionId).data.projectId.size() > 0
      ) ? versionDoc(fileData.versionId).data.projectId : (
        fileData.docId is string
        && fileData.docId.size() > 0
        && documentDoc(fileData.docId).data.projectId is string
        && documentDoc(fileData.docId).data.projectId.size() > 0
      ) ? documentDoc(fileData.docId).data.projectId : '';
    }

    function canReadFileMetadata(fileData) {
      let projectId = resolvedFileProjectId(fileData);
      return isAdmin()
        || (
          projectId is string
          && projectId.size() > 0
          && isProjectMember(projectId)
        )
        || (
          fileData.versionId is string
          && fileData.versionId.size() > 0
          && canReviewAccessByVersionId(fileData.versionId)
        );
    }

    function isAdminFileMetadataBackfill() {
      return isAdmin()
        && request.resource.data.fileKey == resource.data.fileKey
        && request.resource.data.fileName == resource.data.fileName
        && request.resource.data.contentType == resource.data.contentType
        && request.resource.data.sizeBytes == resource.data.sizeBytes
        && request.resource.data.storageProvider == resource.data.storageProvider
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'projectId',
          'docId',
          'versionId',
          'updatedAt',
          'updatedBy'
        ]);
    }


    function isValidVersionState(state) {
      return state in [
        'In Creation',
        'In Review',
        'Reviewed',
        'Rejected',
        'Replaced',
        'Accepted'
      ];
    }

    function isValidStorageProvider(value) {
      return value in ['files-api', 'firebase-storage'];
    }

    function isValidEmailProvider(value) {
      return value in ['files-api', 'firebase-functions'];
    }

    match /userProfiles/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.isAdmin == false;
      allow update: if isSelf(userId)
        && request.resource.data.isAdmin == resource.data.isAdmin;
      allow delete: if false;
    }

    match /userDirectory/{emailKey} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.auth.token.email is string
        && request.resource.data.email is string
        && request.resource.data.emailKey is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailKey == request.auth.token.email
        && emailKey == request.auth.token.email;
      allow update: if isSignedIn()
        && request.auth.token.email is string
        && emailKey == request.auth.token.email
        && resource.data.emailKey == request.auth.token.email
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.emailKey is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailKey == request.auth.token.email
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'userId',
          'emailLower',
          'displayName',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /systemConfig/{configId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && configId == 'runtime'
        && request.resource.data.fileStorageProvider is string
        && request.resource.data.emailProvider is string
        && isValidStorageProvider(request.resource.data.fileStorageProvider)
        && isValidEmailProvider(request.resource.data.emailProvider)
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow read: if isProjectMember(projectId) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.matches('.*\\S.*')
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.shortId is int
        && request.resource.data.shortId > 0;
      allow update: if isProjectLeader(projectId) || isAdmin();
      allow delete: if false;
    }

    match /projectMembers/{memberId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid)
        || isProjectMember(resource.data.projectId)
        || isAdmin();
      allow create: if ((isAdmin() || isProjectLeader(request.resource.data.projectId))
          && request.resource.data.role in ['leader', 'member']
          && memberId == request.resource.data.projectId + '_' + request.resource.data.userId)
        || (isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role == 'leader'
          && memberId == request.resource.data.projectId + '_' + request.auth.uid);
      allow update: if isProjectLeader(resource.data.projectId) || isAdmin();
      allow delete: if false;
    }

    match /documents/{docId} {
      allow read: if isProjectMember(resource.data.projectId)
        || isAdmin()
        || (isSignedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if (isProjectMember(request.resource.data.projectId) || isAdmin())
        && request.resource.data.title is string
        && request.resource.data.title.matches('.*\\S.*')
        && request.resource.data.shortId is int
        && request.resource.data.shortId > 0
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (
          (isProjectLeader(resource.data.projectId) || isDocumentAuthor() || isAdmin())
          && request.resource.data.projectId == resource.data.projectId
          && request.resource.data.createdBy == resource.data.createdBy
        )
        || isShortIdAssignment();
      allow delete: if false;
    }

    match /files/{fileId} {
      allow read: if canReadFileMetadata(resource.data);
      allow create: if (
          isProjectMember(request.resource.data.projectId)
          || isAdmin()
          || (
            request.resource.data.versionId is string
            && request.resource.data.versionId.size() > 0
            && isVersionAuthorById(request.resource.data.versionId)
          )
        )
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.projectId is string
        && request.resource.data.docId is string
        && request.resource.data.versionId is string
        && request.resource.data.fileKey is string
        && request.resource.data.fileName is string
        && request.resource.data.sizeBytes is int
        && request.resource.data.storageProvider is string
        && isValidStorageProvider(request.resource.data.storageProvider);
      allow update: if isAdminFileMetadataBackfill();
      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && (counterId in ['documents', 'projects'] || counterId.matches('documents_.*') || counterId.matches('versions_.*'))
        && request.resource.data.nextNumber is int
        && request.resource.data.nextNumber > 0
        && (
          isAdmin()
          || (
            counterId == 'projects'
            && request.resource.data.lastProjectId is string
            && request.resource.data.lastProjectId.size() > 0
            && getAfter(/databases/$(database)/documents/projects/$(request.resource.data.lastProjectId)).data.leaderId == request.auth.uid
            && getAfter(/databases/$(database)/documents/projects/$(request.resource.data.lastProjectId)).data.shortId
              == request.resource.data.nextNumber - 1
          )
          || (
            counterId.matches('documents_.*')
            && request.resource.data.projectId is string
            && counterId == 'documents_' + request.resource.data.projectId
            && isProjectMember(request.resource.data.projectId)
          )
          || (
            counterId.matches('versions_.*')
            && request.resource.data.docId is string
            && request.resource.data.projectId is string
            && counterId == 'versions_' + request.resource.data.docId
            && (
              canCreateVersionByPolicy(
                request.resource.data.projectId,
                request.resource.data.docId,
                request.resource.data.nextNumber - 1,
                request.resource.data.previousVersionId
              )
              || isAcceptedVersionCounterJump(
                request.resource.data.projectId,
                request.resource.data.docId,
                request.resource.data.nextNumber,
                request.resource.data.previousVersionId
              )
            )
          )
        )
        && (
          (resource == null && (
            request.resource.data.nextNumber == 2
            || hasPreviousVersionChainForCounter(
              request.resource.data.projectId,
              request.resource.data.docId,
              request.resource.data.nextNumber,
              request.resource.data.previousVersionId
            )
          ))
          || (
            resource != null
            && request.resource.data.nextNumber == resource.data.nextNumber + 1
          )
          || (
            resource != null
            && isAcceptedVersionCounterJump(
              request.resource.data.projectId,
              request.resource.data.docId,
              request.resource.data.nextNumber,
              request.resource.data.previousVersionId
            )
          )
          || isAdmin()
        );
      allow delete: if false;
    }

    match /versions/{versionId} {
      allow read: if isProjectMember(resource.data.projectId)
        || (isSignedIn()
          && documentDoc(resource.data.docId).data.createdBy == request.auth.uid)
        || isVersionAuthor(resource.data)
        || isVersionReviewer(resource.data)
        || isAdmin();
      allow create: if canCreateVersionByPolicy(
          request.resource.data.projectId,
          request.resource.data.docId,
          request.resource.data.number,
          request.resource.data.previousVersionId
        )
        && request.resource.data.docId is string
        && request.resource.data.projectId is string
        && request.resource.data.number is int
        && request.resource.data.number > 0
        && (
          request.resource.data.number == 1
          || hasPreviousVersionChainForCreate(
            request.resource.data.projectId,
            request.resource.data.docId,
            request.resource.data.number,
            request.resource.data.previousVersionId
          )
        )
        && request.resource.data.status == 'In Creation'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.reviewerIds is list
        && isValidVersionState(request.resource.data.status);
      allow update: if (
          (isProjectLeader(resource.data.projectId)
            || isVersionAuthor(resource.data)
            || isAdmin())
          && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.docId == resource.data.docId
        && (request.resource.data.createdBy == resource.data.createdBy || isAuthorReassignmentAllowed())
        && request.resource.data.keys().hasAll(resource.data.keys())
          && (
            isSameStatusUpdateAllowed()
            || isStartReviewTransition()
            || isReviewedTransition()
            || isAcceptTransition()
            || isRejectTransition()
            || isReplacedTransition()
          )
        )
        || isReviewStatsOnlyUpdate(versionId)
        || isAdminStatsBackfill();
      allow delete: if false;
    }

    match /threads/{threadId} {
      allow read: if isProjectMember(resource.data.projectId)
        || canReviewAccess(resource.data.projectId, resource.data.versionId)
        || canReviewAccessByVersionId(resource.data.versionId);
      allow create: if canReviewContribute(request.resource.data.projectId, request.resource.data.versionId)
        && request.resource.data.status == 'open'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && isThreadCreateWithVersionStatIncrement(request.resource.data.versionId);
      allow update: if canReviewContribute(resource.data.projectId, resource.data.versionId)
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.versionId == resource.data.versionId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.keys().hasAll(resource.data.keys())
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'closedBy',
          'closedAt',
          'reopenedBy',
          'reopenedAt',
          'commentCount',
          'lastCommentAt',
          'lastCommentBy',
          'updatedAt',
          'updatedBy'
        ])
        && (
          (resource.data.status == 'open'
            && request.resource.data.status == 'closed'
            && isThreadStatusWithVersionOpenCounter(resource.data.versionId, true))
          ||
          (resource.data.status == 'closed'
            && request.resource.data.status == 'open'
            && isThreadStatusWithVersionOpenCounter(resource.data.versionId, false))
          ||
          (request.resource.data.status == resource.data.status)
        )
        || isAdminProjectIdBackfill();
      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if isProjectMember(resource.data.projectId)
        || canReviewAccess(resource.data.projectId, resource.data.versionId)
        || canReviewAccessByVersionId(resource.data.versionId)
        || (isSignedIn() && resource.data.createdBy == request.auth.uid)
        || (isSignedIn()
          && request.query != null
          && request.query.where != null
          && request.query.where.size() > 0
          && request.query.where[0].field == 'createdBy'
          && request.query.where[0].op == '=='
          && request.query.where[0].value == request.auth.uid);
      allow create: if canReviewContribute(request.resource.data.projectId, request.resource.data.versionId)
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && isCommentCreateWithVersionStatIncrement(request.resource.data.versionId, request.resource.data.threadId);
      allow update: if isAdminProjectIdBackfill();
      allow delete: if false;
    }

    match /changeRequests/{crId} {
      allow read: if isProjectMember(resource.data.projectId) || isAdmin();
      allow create: if isProjectMember(request.resource.data.projectId) || isAdmin();
      allow update: if isProjectLeader(resource.data.projectId) || isAdmin();
      allow delete: if false;
    }

    match /testProcedures/{docId} {
      allow read: if isProjectMember(resource.data.projectId) || isAdmin();
      allow create: if isProjectMember(request.resource.data.projectId) || isAdmin();
      allow update: if isProjectLeader(resource.data.projectId) || isAdmin();
      allow delete: if false;
    }

    match /testLogs/{docId} {
      allow read: if isProjectMember(resource.data.projectId) || isAdmin();
      allow create: if isProjectMember(request.resource.data.projectId) || isAdmin();
      allow update: if isProjectLeader(resource.data.projectId) || isAdmin();
      allow delete: if false;
    }

    match /testDesigns/{docId} {
      allow read: if isProjectMember(resource.data.projectId) || isAdmin();
      allow create: if isProjectMember(request.resource.data.projectId) || isAdmin();
      allow update: if isProjectLeader(resource.data.projectId) || isAdmin();
      allow delete: if false;
    }

    match /testCases/{docId} {
      allow read: if isProjectMember(resource.data.projectId) || isAdmin();
      allow create: if isProjectMember(request.resource.data.projectId) || isAdmin();
      allow update: if isProjectLeader(resource.data.projectId) || isAdmin();
      allow delete: if false;
    }

    match /dashboard/{userId} {
      allow read, write: if isSelf(userId);

      match /tasks/{taskId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin() || resource.data.actorId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
