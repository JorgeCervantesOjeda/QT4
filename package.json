{
  "name": "qt4",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "dev:test": "vite --mode test",
    "dev:emulator": "vite --mode emulator",
    "dev:e2e": "vite --mode e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tools/run_emulator_e2e.mjs",
    "test:e2e:fake": "playwright test -c playwright.fake.config.ts",
    "test:traffic": "node tools/run_emulator_traffic.mjs",
    "test:traffic:smoke": "node tools/run_emulator_traffic.mjs --profile smoke",
    "test:traffic:baseline": "node tools/run_emulator_traffic.mjs --profile baseline",
    "test:traffic:stress": "node tools/run_emulator_traffic.mjs --profile stress",
    "seed:emulators": "node tools/seed_emulators.mjs",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test",
    "build:prod": "tsc -b && vite build --mode production",
    "deploy:functions:test": "npx firebase-tools deploy --only functions --project qualiteam-plus-test",
    "deploy:functions:prod": "npx firebase-tools deploy --only functions --project qualiteam-app",
    "deploy:test": "npm run build:test && npx firebase-tools deploy --only hosting:test,firestore,storage --project qualiteam-plus-test",
    "deploy:prod": "npm run build:prod && npx firebase-tools deploy --only hosting:prod,firestore,storage --project qualiteam-app",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.20.5",
    "date-fns": "^2.30.0",
    "firebase": "^12.8.0",
    "firebase-functions": "^7.0.6",
    "react": "^19.2.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.7.0",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.2"
  }
}
