rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile(userId) {
      return firestore.get(/databases/(default)/documents/userProfiles/$(userId));
    }

    function isAdmin() {
      return isSignedIn() && userProfile(request.auth.uid).data.isAdmin == true;
    }

    function projectMemberDoc(projectId) {
      return firestore.get(/databases/(default)/documents/projectMembers/$(projectId + '_' + request.auth.uid));
    }

    function isProjectMember(projectId) {
      return isSignedIn() && projectMemberDoc(projectId).data.role in ['leader', 'member'];
    }

    match /qt4/{projectId}/{documentId}/{versionId}/{fileName} {
      allow read, write: if isProjectMember(projectId) || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
