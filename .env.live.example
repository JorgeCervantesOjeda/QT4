# .env.live.example: Template for running local code against the live production Firebase project.
# Copy to .env.live and fill with the same Firebase/Files API values used by production.

# Firebase (live production data from local Vite dev server)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Files API live production access
VITE_FILES_API_MODE=direct
VITE_FILES_API_BASE_URL=https://archivos.dmas.cua.uam.mx/api/v1

# Not used in direct mode, kept for parity with other env files
VITE_FILES_API_PROXY_PATH=/files-api
QT4_FILES_API_BASE_URL=

# Runtime provider defaults (used when systemConfig/runtime is missing)
VITE_DEFAULT_FILE_STORAGE_PROVIDER=files-api
VITE_DEFAULT_EMAIL_PROVIDER=files-api

# Optional hard override (always use this file storage provider)
# Allowed values: files-api | firebase-storage
VITE_FORCE_FILE_STORAGE_PROVIDER=

# Used only when email provider is firebase-functions
VITE_FIREBASE_NOTIFY_FUNCTION_URL=

# Used by abnormal error monitoring
VITE_FIREBASE_MONITOR_FUNCTION_URL=

# Used by transactional version accept/reject decisions
VITE_FIREBASE_VERSION_DECISION_FUNCTION_URL=

VITE_GIPHY_API_KEY=
