SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_FROM=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=

# Optional compatibility aliases (same names used by archivos-api)
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USER=
MAIL_FROM_ADDRESS=
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_CLIENT_SECRET=
MAIL_OAUTH_REFRESH_TOKEN=

# Optional legacy aliases from QualiTeam_NB8 MailerAgent (Gmail OAuth2)
QUALITEAM_GMAIL_USER=
QUALITEAM_GMAIL_CLIENT_ID=
QUALITEAM_GMAIL_CLIENT_SECRET=
QUALITEAM_GMAIL_REFRESH_TOKEN=

# Optional comma-separated list of allowed origins.
# Example: https://qualiteam.cua.uam.mx,https://qualiteam-app.web.app
NOTIFY_ALLOWED_ORIGINS=
