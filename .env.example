VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Files API local development (Vite proxy mode)
VITE_FILES_API_MODE=proxy
VITE_FILES_API_PROXY_PATH=/files-api
QT4_FILES_API_BASE_URL=http://localhost:42873/api/v1

# Used only in direct mode
VITE_FILES_API_BASE_URL=

# Runtime provider defaults (used when systemConfig/runtime is missing)
VITE_DEFAULT_FILE_STORAGE_PROVIDER=files-api
VITE_DEFAULT_EMAIL_PROVIDER=files-api

# Optional hard override (always use this file storage provider)
# Allowed values: files-api | firebase-storage
VITE_FORCE_FILE_STORAGE_PROVIDER=

# Used only when email provider is firebase-functions
# Example: https://us-central1-qualiteam-app.cloudfunctions.net/notifyEmail
VITE_FIREBASE_NOTIFY_FUNCTION_URL=

# Used by abnormal error monitoring
# Example: https://us-central1-qualiteam-app.cloudfunctions.net/reportClientMonitorEvent
VITE_FIREBASE_MONITOR_FUNCTION_URL=
VITE_APP_BUILD=

VITE_GIPHY_API_KEY=
